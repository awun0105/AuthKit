{
  "name": "authkit-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"examples/fullstack-nextjs/**/*.{ts,tsx}\" --max-warnings=0",
    "build:example": "pnpm --filter authkit-fullstack-nextjs-example build",
    "test:e2e": "pnpm --filter authkit-fullstack-nextjs-example test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.1.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.70.0"
  }
}
